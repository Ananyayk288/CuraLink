# CuraLink Pharmacy Portal Environment Config

# Data Provider: 'mock' (Active Now) or 'supabase' (Ready for DB switch)
DATA_PROVIDER=mock

# Supabase Credentials (Required only when DATA_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Developer Simulation Tools (Simulates Doctor actions: revision commit & substitution review)
NEXT_PUBLIC_DEV_TOOLS=true

# Inventory Freshness Thresholds (in hours)
FRESH_HOURS_THRESHOLD=24
AGING_HOURS_THRESHOLD=72

# Dispensing Safety: Minimum Shelf Life (in days)
MIN_SHELF_LIFE_DAYS=30
