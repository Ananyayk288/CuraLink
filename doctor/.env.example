# 1. Supabase PostgreSQL Credentials
# Provide your Supabase project ID and anon key here.
# When provided, all prescriptions, diagnostic scans, follow-ups,
# and AI voice agent triggers will immediately synchronize with Supabase!
SUPABASE_PROJECT_ID=
SUPABASE_ANON_KEY=
SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# 2. Server Configuration
PORT=8080

# 3. Local SQLite Fallback Path
AROGYAVANI_DB_PATH=arogyavani.db
